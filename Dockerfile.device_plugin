FROM golang:1.27 AS build
WORKDIR /build
COPY ./kubernetes/device-plugin/go.mod ./kubernetes/device-plugin/go.sum ./
RUN go mod download
COPY ./kubernetes/device-plugin/ ./
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o nvshare-device-plugin


FROM scratch
COPY --from=build /build/nvshare-device-plugin /usr/local/bin/nvshare-device-plugin
ENTRYPOINT ["/usr/local/bin/nvshare-device-plugin"]
